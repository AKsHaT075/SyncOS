# Sync OS backend. Copy to backend/.env and fill in. NEVER commit .env (it is gitignored).
# Full reference with defaults: docs/development.md and docs/ai/ai-operations.md.

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# --- Required (the server refuses to start without these) ---
MONGO_URI=mongodb://127.0.0.1:27017/syncos
JWT_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string

# --- Redis (sessions, rate limits, notification fan-out, email queue, AI limits) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Cookies (must match the frontend's NEXT_PUBLIC_*_COOKIE_NAME values) ---
# AUTH_ACCESS_COOKIE_NAME=sync_access_token
# AUTH_REFRESH_COOKIE_NAME=sync_refresh_token
# AUTH_CSRF_COOKIE_NAME=sync_csrf_token
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# --- Email (OTP, invitations, notification emails). Without it, mail sending fails. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sync Os <no-reply@example.com>"

# --- Documents / file storage (local disk provider) ---
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=./uploads/documents
# UPLOAD_TMP_DIR=./uploads/tmp
# DOCUMENT_MAX_FILE_SIZE_MB=25

# --- LiveKit (meetings). Leave empty to disable video rooms. ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_ENABLED=false

# --- Notifications ---
# NOTIFICATION_RETENTION_DAYS=90

# --- AI (Node side). Groq credentials live ONLY in ai/.env, never here. ---
# Generate keys:  node backend/scripts/generate-ai-keys.js  (prints the lines to paste here and into ai/.env)
AI_GLOBAL_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY_ID=v1
AI_SERVICE_SIGNING_KEY_FILE=../ai/keys/ai-jwt-private.pem
AI_INTERNAL_HOST=127.0.0.1
AI_INTERNAL_PORT=5002
AI_WORKER_KEY_ID=w1
AI_WORKER_PUBLIC_KEY_FILE=../ai/keys/ai-worker-public.pem
# Live data tools are OFF by default and must stay off until the rollout checklist in docs/ai/ai-operations.md is done.
AI_LIVE_TOOLS_ENABLED=false
# Tokens one plan "AI credit" is worth. Unset = AI credits are not enforced (see docs/modules.md, Organizations).
# AI_TOKENS_PER_CREDIT=
