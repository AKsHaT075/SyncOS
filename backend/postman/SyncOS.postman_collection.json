{
  "info": {
    "_postman_id": "syncos-backend-collection",
    "name": "SyncOS Backend API",
    "description": "Covers every implemented endpoint as of the auth + multi-tenant RBAC milestone: health check, auth, organizations, invitations, audit logs, and platform (super-admin) administration.\n\nImport the companion environment `SyncOS - Local` and run requests top-to-bottom inside each folder — later requests depend on variables captured by earlier ones (csrfToken, accessToken, organizationId, invitationToken, sessionId).\n\nSee API_TESTING_GUIDE.md in this folder for the full input/output reference and a manual test checklist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.response.json().success === true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/csrf-token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "csrf-token"] },
            "description": "Public. Issues a CSRF token cookie (sync_csrf_token) and returns the same value in the body. Call this first, then send the value back via X-CSRF-Token on every mutating request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('csrfToken', json.csrfToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "description": "Public, exempt from CSRF. Creates an unverified user and emails a 6-digit OTP. Check the SMTP inbox (or server logs in dev) for the OTP, then put it in the `otp` environment variable before running 'Verify Email'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns user', () => pm.response.json().user.email === pm.environment.get('userEmail'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3. Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "verify-email"] },
            "description": "Public, exempt from CSRF. Set environment variable `otp` to the 6-digit code emailed during Register before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "4. Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "resend-otp"] },
            "description": "Public, exempt from CSRF. Use only if the original OTP expired (5 min TTL)."
          },
          "response": []
        },
        {
          "name": "5. Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "description": "Public, exempt from CSRF. Requires email to be verified first. Sets sync_access_token, sync_refresh_token, sync_csrf_token cookies and returns accessToken + user in the body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "if (json.user && json.user.organization) pm.environment.set('organizationId', json.user.organization);",
                  "const csrfCookie = pm.cookies.get('sync_csrf_token') || pm.cookies.get('synapse_csrf_token');",
                  "if (csrfCookie) pm.environment.set('csrfToken', csrfCookie);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "6. Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "description": "Public route, exempt from CSRF, but requires the sync_refresh_token cookie set by Login to be present in Postman's cookie jar for {{baseUrl}}'s host. Rotates tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "const csrfCookie = pm.cookies.get('sync_csrf_token') || pm.cookies.get('synapse_csrf_token');",
                  "if (csrfCookie) pm.environment.set('csrfToken', csrfCookie);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "7. Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" }
            }
          ],
          "response": []
        },
        {
          "name": "8. List My Sessions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/sessions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "sessions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.sessions && json.sessions.length) pm.environment.set('sessionId', json.sessions[0].id || json.sessions[0]._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "9. Revoke a Session",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sessions", ":sessionId"],
              "variable": [{ "key": "sessionId", "value": "{{sessionId}}" }]
            },
            "description": "Requires CSRF header. Pick a sessionId other than the one currently in use, or you will be logged out."
          },
          "response": []
        },
        {
          "name": "10. Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "description": "Public, exempt from CSRF. Always returns a generic success message regardless of whether the account exists. Check email/logs for the reset token and put it in `resetToken`."
          },
          "response": []
        },
        {
          "name": "11. Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password"] },
            "description": "Public, exempt from CSRF. Revokes all existing sessions on success — you will need to log in again."
          },
          "response": []
        },
        {
          "name": "12. Logout (current device)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          },
          "response": []
        },
        {
          "name": "13. Logout All Devices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout-all", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout-all"] },
            "description": "Bumps the user's tokenVersion, invalidating every refresh token/session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "1. Create Organization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{organizationName}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/organizations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organizations"] },
            "description": "Any authenticated user can create an org. The creating user becomes org-admin and `hasCreatedOrganization` flips to true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('organizationId', json.organization.id || json.organization._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. List My Organizations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/organizations/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organizations", "me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invitations (org-admin)",
      "item": [
        {
          "name": "1. Invite User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteeEmail}}\",\n  \"role\": \"{{inviteeRole}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/invitations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "invitations"] },
            "description": "Requires the logged-in user to be org-admin. role must be one of: hr, manager, employee. Emails an invite link containing a token — copy that token into `invitationToken` for Accept Invitation, and check List Invitations for the invitationId."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"], "type": "text/javascript" }
            }
          ],
          "response": []
        },
        {
          "name": "2. List Invitations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invitations?status=pending&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invitations"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Requires org-admin. status is optional: pending | accepted | revoked | expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.invitations && json.invitations.length) pm.environment.set('invitationId', json.invitations[0].id || json.invitations[0]._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3. Accept Invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invitationToken}}\",\n  \"firstName\": \"{{inviteeFirstName}}\",\n  \"lastName\": \"{{inviteeLastName}}\",\n  \"password\": \"{{inviteePassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/invitations/accept", "host": ["{{baseUrl}}"], "path": ["api", "v1", "invitations", "accept"] },
            "description": "Public, exempt from CSRF. Creates the invited user already email-verified, joined to the inviter's organization with the invited role. Token comes from the invite email."
          },
          "response": []
        },
        {
          "name": "4. Resend Invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invitations/:id/resend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invitations", ":id", "resend"],
              "variable": [{ "key": "id", "value": "{{invitationId}}" }]
            },
            "description": "org-admin only. Resets the invite token/expiry and re-sends the email."
          },
          "response": []
        },
        {
          "name": "5. Revoke Invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invitations/:id/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invitations", ":id", "revoke"],
              "variable": [{ "key": "id", "value": "{{invitationId}}" }]
            },
            "description": "org-admin only. Fails with 409 INVITE_ALREADY_ACCEPTED if the invite was already used."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit Logs (org-admin)",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "action", "value": "", "disabled": true },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true }
              ]
            },
            "description": "org-admin only. Scoped to the caller's own organization. action/userId/startDate/endDate filters are optional (enable as needed)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Platform Admin (super-admin)",
      "item": [
        {
          "name": "1. List All Organizations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Requires role super-admin. There is no self-service way to become super-admin via the API — set it directly in the database for your test user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.organizations && json.organizations.length) pm.environment.set('platformOrganizationId', json.organizations[0].id || json.organizations[0]._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Get Organization by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations", ":id"],
              "variable": [{ "key": "id", "value": "{{platformOrganizationId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "3. Update Organization Plan",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"pro\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations/:id/plan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations", ":id", "plan"],
              "variable": [{ "key": "id", "value": "{{platformOrganizationId}}" }]
            },
            "description": "plan must be one of: free, starter, pro, enterprise."
          },
          "response": []
        },
        {
          "name": "4. Suspend Organization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Manual review\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations/:id/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations", ":id", "suspend"],
              "variable": [{ "key": "id", "value": "{{platformOrganizationId}}" }]
            },
            "description": "reason is optional, max 500 chars."
          },
          "response": []
        },
        {
          "name": "5. Reactivate Organization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations/:id/reactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations", ":id", "reactivate"],
              "variable": [{ "key": "id", "value": "{{platformOrganizationId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "6. Update Feature Flags",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"featureFlags\": {\n    \"betaDashboard\": true,\n    \"aiAssistant\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations/:id/feature-flags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "platform", "organizations", ":id", "feature-flags"],
              "variable": [{ "key": "id", "value": "{{platformOrganizationId}}" }]
            },
            "description": "featureFlags is an object of string keys to boolean values."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" }
  ]
}
