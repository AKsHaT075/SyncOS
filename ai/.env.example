# Sync OS AI service. Copy to .env (never commit it). Internal only: bind to loopback / a private network.
HOST=127.0.0.1
PORT=8001

# Public half of the ES256 key pair whose private half lives in the Node backend.
# Generate a pair with:  node backend/scripts/generate-ai-keys.js
AI_JWT_KEY_ID=v1
AI_JWT_PUBLIC_KEY_FILE=./keys/ai-jwt-public.pem
# or AI_JWT_PUBLIC_KEY=<PEM or base64 of PEM>;  for rotation: AI_JWT_PUBLIC_KEYS={"v1":"<PEM>","v2":"<PEM>"}

# Replay protection for single-use tokens. "redis" is correct for any number of replicas.
# "memory" is valid for exactly ONE process and requires AI_SINGLE_INSTANCE=true.
AI_REPLAY_STORE=redis
REDIS_URL=redis://127.0.0.1:6379
AI_REDIS_PREFIX=ai-service
# AI_SINGLE_INSTANCE=true

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_CHAT=openai/gpt-oss-120b
# AI_MODEL_SUMMARIZE=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=90000
AI_FIRST_BYTE_TIMEOUT_MS=20000
AI_STREAM_IDLE_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048

# ---- Ingestion worker (a SEPARATE process: `python -m app.ingestion.worker`). It needs NONE of the settings above,
# ---- in particular no GROQ_API_KEY. Give it only these.
# AI_WORKER_KEY_ID=w1
# AI_WORKER_SIGNING_KEY_FILE=./keys/ai-worker-private.pem     # ES256 PRIVATE key; Node holds only the public half
# AI_NODE_INTERNAL_URL=http://127.0.0.1:5002
# AI_WORKER_ID=worker-1
# AI_INGEST_POLL_SECONDS=3
# AI_INGEST_TMP_DIR=/var/tmp/syncos-ingest                    # 0600 temp files, removed after each job
# AI_INGEST_MAX_FILE_MB=25
# AI_INGEST_MAX_TEXT_CHARS=3000000
# AI_INGEST_TIMEOUT_SECONDS=90
# AI_INGEST_CPU_SECONDS=80
# AI_INGEST_MEMORY_MB=1536                                    # enforced on Linux (RLIMIT_AS); best effort on macOS

# ---- Embedding worker (a THIRD process: `python -m app.embeddings.worker`). Needs the worker key (above) and these. ----
# AI_ENVIRONMENT=production                 # production REFUSES embedded Qdrant, plain-http Qdrant, and the fake provider
# AI_EMBEDDING_PROVIDER=fastembed           # "fake" is for tests only
# AI_EMBEDDING_CACHE_DIR=/var/cache/syncos-models   # Hugging Face cache; the model is ~470 MB, downloaded once
# AI_EMBEDDING_OFFLINE=true                 # never touch the network (air-gapped): the cache must already hold the model
# AI_EMBEDDING_THREADS=0                    # 0 = library default; the worker uses ~5 cores and ~1 GB RSS (plan >= 2 GB)
# AI_EMBEDDING_BATCH_SIZE=16
# AI_EMBEDDING_PAGE_SIZE=64
# Qdrant: development default is EMBEDDED (QDRANT_PATH, no server, single process only). Production: a private server.
# QDRANT_PATH=.qdrant-data
# QDRANT_URL=https://qdrant.internal:6333   # non-loopback => https AND an API key are required
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=syncos_chunks
# QDRANT_TIMEOUT_SECONDS=10

# --- Phase 5: retrieval (RAG) ---
# AI_RAG_ENABLED=false                       # must be true for /internal/v1/answer; needs a Qdrant SERVER (not embedded) when the worker runs
# AI_NODE_INTERNAL_URL=http://127.0.0.1:5002
# AI_RAG_TOP_K=6
# AI_RAG_CANDIDATES=24
# AI_RAG_MAX_CANDIDATES=200
# AI_RAG_MIN_SCORE=0.81                      # calibrated for multilingual-e5-small; recalibrate if the model changes
# AI_RAG_SCORE_WINDOW=0.05
# AI_RAG_CONTEXT_TOKENS=3000
# AI_RAG_MAX_PER_DOCUMENT=3
# AI_RAG_NEAR_DUPLICATE=0.70

# Phase 6 note: follow-up rewriting reuses the chat model; no new settings.

# ---- Live organizational tools (Phase 8). Python never decides access: Node signs the limits for each request and Python can only be STRICTER.
# ---- Defaults equal Node's defaults; raising them above Node's has no effect. Tools are only used for a request Node authorized (signed `lt` claim + tool token).
# AI_NODE_INTERNAL_URL=http://127.0.0.1:5002     # Node's private callback listener (tool execution and document authorization); a plain http(s) origin
# AI_TOOL_MAX_ROUNDS=3
# AI_TOOL_MAX_CALLS=5
# AI_TOOL_MAX_CONCURRENT=2
# AI_TOOL_TIMEOUT_MS=8000
# AI_TOOL_TOTAL_MS=20000
# AI_TOOL_MAX_RESULT_BYTES=8192
# AI_TOOL_KEEPALIVE_MS=10000                     # `: keepalive` comment while a model call is in flight (100-20000); never counts against the request ceiling

